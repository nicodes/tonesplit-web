			gap: 16px;
			font-size: 11px;
		}
		.wordmark {
			font-size: 21px;
		}
		.bottom {
			flex-wrap: wrap;
		}
		.cta {
			padding: 16px 20px;
		}
		th,
		td {
			padding: 12px 7px;
			font-size: 11px;
		}
		main > section {
			margin-bottom: 55px;
		}
	}
	.sound-cover {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		align-items: end;
		gap: 80px;
		padding: 45px 0 20px;
	}
	.sound-cover h1 {
		font-size: clamp(64px, 7.5vw, 110px);
		line-height: 0.98;
		letter-spacing: -0.065em;
		font-weight: 600;
		margin: 25px 0;
	}
	.sound-cover em {
		font-family: Georgia, serif;
		font-weight: 400;
		color: #a64928;
	}
	.sound-intro > p:first-child {
		font-size: 19px;
		max-width: 380px;
	}
	.cta {
		background: #a64928;
		color: #fff;
	}
	.source-label {
		margin-top: 23px;
		color: #736f61;
	}
	.instrument {
		padding: 22px;
		background: #333a33;
		border: 6px solid #bec0af;
		border-radius: 18px;
		box-shadow: 0 25px 40px #303e2720;
		color: #e7e9cb;
	}
	.instrument-top,
	.instrument-foot {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font: 10px var(--mono);
		padding: 10px 12px 22px;
	}
	.live-dot {
		color: #b7c09a;
	}
	.big-scope {
		display: grid;
		grid-template-columns: 25px 1fr 25px 1fr;
		align-items: center;
		background: #17201a;
		padding: 22px 18px;
		border-radius: 8px;
		border: 2px solid #101b14;
	}
	.big-scope > span {
		font: 12px var(--mono);
		color: #89a978;
	}
	.big-scope svg {
		width: 100%;
		height: 140px;
	}
	.big-scope path {
		fill: none;
		stroke-width: 1.4;
	}
	.rack {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		padding: 18px 0;
	}
	.module {
		background: linear-gradient(#c8cbb4, #aeb5a0);
		color: #263629;
		padding: 22px 20px;
		border-radius: 5px;
		border: 1px solid #e2e4cf;
		box-shadow: 0 5px 8px #0004;
	}
	.module-label {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font: 10px var(--mono);
	}
	.module-label i {
		width: 7px;
		height: 7px;
		border-radius: 50%;
	}
	.frequency {
		font: 44px/1 var(--mono);
		letter-spacing: -0.06em;
		margin: 25px 0;
	}
	.frequency small {
		font-size: 12px;
		padding-left: 6px;
		letter-spacing: 0;
	}
	.dial {
		width: 98px;
		height: 98px;
		margin: 20px auto 28px;
		background: repeating-conic-gradient(#29372d 0deg 2deg, transparent 2deg 15deg);
		border-radius: 50%;
		padding: 8px;
		position: relative;
	}
	.dial:before {
		content: '';
		position: absolute;
		inset: 9px;
		border-radius: 50%;
		background: linear-gradient(120deg, #5b6658, #23372a);
		border: 3px solid #8e9785;
		box-shadow: 4px 7px 9px #16211966;
	}
	.dial > span {
		position: absolute;
		width: 2px;
		height: 34px;
		background: #dbe1b1;
		top: 16px;
		left: 48px;
		transform-origin: 1px 33px;
	}
	.module-values {
		display: flex;
		flex-wrap: wrap;
		gap: 9px;
		justify-content: space-between;
		font: 9px var(--mono);
	}
	.instrument-foot {
		padding: 12px 10px 0;
	}
	.instrument-foot a {
		color: #dce5b9;
	}
	.sound-notes {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 100px;
	}
