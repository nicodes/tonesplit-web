---
// biome-ignore lint/correctness/noUnusedImports: layout component, used in the template below -- biome's .astro support misses template usage
import Full from '../layouts/Full.astro';

const appUrl = 'https://app.tonesplit.com';

// The screen on this page is drawn from the app's own numbers rather than
// described in prose, so the two cannot quietly drift apart.

// What Tone Split opens with: 108 and 111 Hz panned hard left, 114 and 117 hard
// right. Two pairs three hertz apart, which is three beats a second in each ear.
const tones = [
	{ frequency: 108, waveform: 'sine', volume: 0.3, pan: -1, colour: '#ff9f43' },
	{ frequency: 111, waveform: 'sine', volume: 0.3, pan: -1, colour: '#f7d154' },
	{ frequency: 114, waveform: 'sine', volume: 0.3, pan: 1, colour: '#67d391' },
	{ frequency: 117, waveform: 'sine', volume: 0.3, pan: 1, colour: '#59b9ff' },
];

// The oscillator, sampled the way the app samples it for its display.
const sample = (waveform: string, value: number) => {
	const cycle = (((value / (Math.PI * 2)) % 1) + 1) % 1;
	if (waveform === 'square') return Math.sin(value) >= 0 ? 1 : -1;
	if (waveform === 'sawtooth') return cycle * 2 - 1;
	if (waveform === 'triangle') return 1 - 4 * Math.abs(cycle - 0.5);
	return Math.sin(value);
};

// One channel is 330 x 128 -- 128 is the app's own channel height, and 330 is
// how wide the scope sits inside the frame below, so the drawing is 1:1 with
// the phone rather than a scaled copy of it. Cycles on screen and amplitude
// come off the tone's own frequency and level, so 111 Hz really is drawn
// slightly tighter than 108, and a quieter voice really is a shorter line.
const CHANNEL = { width: 330, height: 128 };
const wavePath = (tone: (typeof tones)[number], points = 240) => {
	const cycles = Math.max(1.2, Math.min(8, tone.frequency / 90));
	const amplitude = Math.max(2, (CHANNEL.height / 2 - 5) * Math.min(1, tone.volume * 2.5));
	return Array.from({ length: points }, (_, index) => {
		const progress = index / (points - 1);
		const x = progress * CHANNEL.width;
		const y = CHANNEL.height / 2 + sample(tone.waveform, progress * cycles * Math.PI * 2) * amplitude;
		return `${index ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(2)}`;
	}).join(' ');
};

// A voice panned left is drawn in the upper channel, panned right in the lower,
// and a centred one in both -- the same test the app makes, written once here.
const channelTones = (side: 'left' | 'right') =>
	tones.filter((tone) => (side === 'left' ? tone.pan <= 0 : tone.pan >= 0));

// The knob turns through 270°, from -135° at the minimum to +135° at the
// maximum. Every dial on this page is placed by that formula rather than by eye.
const dialAngle = (value: number, min: number, max: number) => ((value - min) / (max - min)) * 270 - 135;

const panLabel = (value: number) =>
	Math.abs(value) < 0.04 ? 'C' : `${value < 0 ? 'L' : 'R'}${Math.round(Math.abs(value) * 100)}`;

const voices = tones.slice(0, 3).map((tone, index) => ({
	...tone,
	number: String(index + 1).padStart(2, '0'),
	dials: [
		{ label: 'FREQ', display: `${Math.round(tone.frequency)} Hz`, angle: dialAngle(tone.frequency, 20, 2000) },
		{ label: 'VOL', display: `${Math.round(tone.volume * 100)}%`, angle: dialAngle(tone.volume, 0, 1) },
		{ label: 'PAN', display: panLabel(tone.pan), angle: dialAngle(tone.pan, -1, 1) },
	],
}));

// The library, built the way the app builds it: eleven roots against eight
// voicings, plus five extended chords on A. Counted rather than claimed.
const roots = ['A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'F#', 'G'];
const voicings = ['maj', 'min', 'dim', 'aug', 'maj7', 'min7', '7', '7sus4'];
const chordNames = [
	...roots.flatMap((root) => voicings.map((voicing) => `${root}${voicing}`)),
	'A6',
	'A9',
	'Amin9',
	'A11',
	'A13',
];

// Amin7 is the worked example below: A, C, E and G as equal-tempered
// frequencies off MIDI 69, which is what the picker hands to four oscillators.
const midiToFrequency = (midi: number) => 440 * 2 ** ((midi - 69) / 12);
const amin7 = [0, 3, 7, 10].map((interval) => midiToFrequency(69 + interval));
---

<Full>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				Tone Split
			</a>
			<nav aria-label="Main">
				<a href="#instrument">The instrument</a>
				<a href="https://app.tonesplit.com">Open app ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="sound-cover">
				<div>
					<p class="tag">A SMALL STEREO SYNTHESIZER</p>
					<h1>
						Make room
						<br />
						for <em>sound.</em>
					</h1>
				</div>
				<div class="sound-intro">
					<p>
						Layer a tone. Find a chord. Move a voice across the stereo field. A little instrument for listening closely.
					</p>
					<a class="cta" href={appUrl}>
						Open Tone Split <span>↗</span>
					</a>
					<p class="source-label">BEST IN HEADPHONES · PLAY IN YOUR BROWSER</p>
				</div>
			</section>
			<section id="instrument" class="instrument">
				<div class="instrument-top">
					<span>TONE SPLIT / STEREO VOICE RACK</span>
					<span class="live-dot">ILLUSTRATIVE INSTRUMENT</span>
				</div>
				<div class="big-scope">
					<span>L</span>
					<svg viewBox="0 0 330 128" aria-label="The two left-channel voices at 108 and 111 Hz" role="img">
						{channelTones('left').map((tone) => (
							<path d={wavePath(tone)} stroke={tone.colour} />
						))}
					</svg>
					<span>R</span>
					<svg viewBox="0 0 330 128" aria-label="The two right-channel voices at 114 and 117 Hz" role="img">
						{channelTones('right').map((tone) => (
							<path d={wavePath(tone)} stroke={tone.colour} />
						))}
					</svg>
				</div>
				<div class="rack">
					{tones.map((tone, index) => (
						<article class="module">
							<div class="module-label">
								<span>VOICE {String(index + 1).padStart(2, '0')}</span>
								<i style={`background:${tone.colour}`}></i>
							</div>
							<p class="frequency">
								{tone.frequency}
								<small>Hz</small>
							</p>
							<div class="dial" aria-hidden="true">
								<span style={`transform:rotate(${dialAngle(tone.frequency, 20, 2000)}deg)`}></span>
							</div>
							<div class="module-values">
								<span>SINE</span>
								<span>30% LEVEL</span>
								<span>{panLabel(tone.pan)}</span>
							</div>
						</article>
					))}
				</div>
				<div class="instrument-foot">
					<span>20—2000 Hz / FOUR WAVEFORMS / INDEPENDENT VOICES</span>
					<a href={appUrl}>Play the instrument ↗</a>
				</div>
			</section>
			<section class="sound-notes">
				<div>
					<p class="tag">FROM A SINGLE TONE</p>
					<h2 class="section-heading">
						Hear what happens
						<br />
						between the notes.
					</h2>
					<p>
						108 and 111 Hz on the left. 114 and 117 on the right. Each pair is three hertz apart. Start there, then find
						a sound of your own.
					</p>
				</div>
				<div class="sound-card">
					<span class="tag">93 CHORD VOICINGS</span>
					<h3>
						A chord is
						<br />
						just the beginning.
					</h3>
					<p>
						Load a voicing as separate oscillators. Detune one note, change its waveform, turn it down or pan it away.
					</p>
					<div class="chord-tags">
						{chordNames.slice(0, 16).map((chord) => (
							<span>{chord}</span>
						))}
					</div>
				</div>
			</section>
			<section class="card-grid">
				<article>
					<p class="tag">01 / SHAPE</p>
					<h3>Four ways to wave.</h3>
					<p>Sine, square, sawtooth and triangle. Give each voice its own timbre.</p>
				</article>
				<article>
					<p class="tag">02 / SPACE</p>
					<h3>A place for every voice.</h3>
					<p>Independent level and pan, from hard left to hard right. The scope shows both channels.</p>
				</article>
				<article>
					<p class="tag">03 / PRECISION</p>
					<h3>Turn it. Or type it.</h3>
					<p>Switch between dials and numeric values. Pitch ranges from 20 Hz to 2 kHz.</p>
				</article>
			</section>
		</main>
		<footer class="bottom">
			<span>Tone Split / pitch, timbre, space</span>
			<nav aria-label="Footer">
				<a href="https://app.tonesplit.com">Open app</a>
			</nav>
		</footer>
	</div>
</Full>
