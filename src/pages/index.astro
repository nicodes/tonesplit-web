---
import Full from '../layouts/Full.astro';
import octicons from '@primer/octicons';

const appUrl = 'https://app.tonesplit.com';
const icon = (name: keyof typeof octicons, size = 16) =>
	octicons[name].toSVG({ width: size, height: size });

// The screen on this page is drawn from the app's own numbers rather than
// described in prose, so the two cannot quietly drift apart.

// What Tone Split opens with: 108 and 111 Hz panned hard left, 114 and 117 hard
// right. Two pairs three hertz apart, which is three beats a second in each ear.
const tones = [
	{ frequency: 108, waveform: 'sine', volume: 0.3, pan: -1, colour: '#ff9f43' },
	{ frequency: 111, waveform: 'sine', volume: 0.3, pan: -1, colour: '#f7d154' },
	{ frequency: 114, waveform: 'sine', volume: 0.3, pan: 1, colour: '#67d391' },
	{ frequency: 117, waveform: 'sine', volume: 0.3, pan: 1, colour: '#59b9ff' },
];

// The oscillator, sampled the way the app samples it for its display.
const sample = (waveform: string, value: number) => {
	const cycle = (((value / (Math.PI * 2)) % 1) + 1) % 1;
	if (waveform === 'square') return Math.sin(value) >= 0 ? 1 : -1;
	if (waveform === 'sawtooth') return cycle * 2 - 1;
	if (waveform === 'triangle') return 1 - 4 * Math.abs(cycle - 0.5);
	return Math.sin(value);
};

// One channel is 330 x 128 -- 128 is the app's own channel height, and 330 is
// how wide the scope sits inside the frame below, so the drawing is 1:1 with
// the phone rather than a scaled copy of it. Cycles on screen and amplitude
// come off the tone's own frequency and level, so 111 Hz really is drawn
// slightly tighter than 108, and a quieter voice really is a shorter line.
const CHANNEL = { width: 330, height: 128 };
const wavePath = (tone: (typeof tones)[number], points = 240) => {
	const cycles = Math.max(1.2, Math.min(8, tone.frequency / 90));
	const amplitude = Math.max(2, (CHANNEL.height / 2 - 5) * Math.min(1, tone.volume * 2.5));
	return Array.from({ length: points }, (_, index) => {
		const progress = index / (points - 1);
		const x = progress * CHANNEL.width;
		const y = CHANNEL.height / 2 + sample(tone.waveform, progress * cycles * Math.PI * 2) * amplitude;
		return `${index ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(2)}`;
	}).join(' ');
};

// A voice panned left is drawn in the upper channel, panned right in the lower,
// and a centred one in both -- the same test the app makes, written once here.
const channelTones = (side: 'left' | 'right') =>
	tones.filter((tone) => (side === 'left' ? tone.pan <= 0 : tone.pan >= 0));

// The knob turns through 270°, from -135° at the minimum to +135° at the
// maximum. Every dial on this page is placed by that formula rather than by eye.
const dialAngle = (value: number, min: number, max: number) =>
	((value - min) / (max - min)) * 270 - 135;

const panLabel = (value: number) =>
	Math.abs(value) < 0.04 ? 'C' : `${value < 0 ? 'L' : 'R'}${Math.round(Math.abs(value) * 100)}`;

const voices = tones.slice(0, 3).map((tone, index) => ({
	...tone,
	number: String(index + 1).padStart(2, '0'),
	dials: [
		{ label: 'FREQ', display: `${Math.round(tone.frequency)} Hz`, angle: dialAngle(tone.frequency, 20, 2000) },
		{ label: 'VOL', display: `${Math.round(tone.volume * 100)}%`, angle: dialAngle(tone.volume, 0, 1) },
		{ label: 'PAN', display: panLabel(tone.pan), angle: dialAngle(tone.pan, -1, 1) },
	],
}));

// The library, built the way the app builds it: eleven roots against eight
// voicings, plus five extended chords on A. Counted rather than claimed.
const roots = ['A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'F#', 'G'];
const voicings = ['maj', 'min', 'dim', 'aug', 'maj7', 'min7', '7', '7sus4'];
const chordNames = [
	...roots.flatMap((root) => voicings.map((voicing) => `${root}${voicing}`)),
	'A6',
	'A9',
	'Amin9',
	'A11',
	'A13',
];

// Amin7 is the worked example below: A, C, E and G as equal-tempered
// frequencies off MIDI 69, which is what the picker hands to four oscillators.
const midiToFrequency = (midi: number) => 440 * 2 ** ((midi - 69) / 12);
const amin7 = [0, 3, 7, 10].map((interval) => midiToFrequency(69 + interval));
---

<Full
	title="Tone Split — A stereo synthesizer in your pocket"
	description="Stack oscillators or load one of 93 chord voicings, shape each voice with a waveform, a level and a place in the stereo field, and watch both channels answer as you move."
>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="/" aria-label="Tone Split home">
				<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
					<path d="M16 3 28 10v12L16 29 4 22V10L16 3Z"></path>
					<path d="M9 13q3.5-4.5 7 0t7 0M9 21q3.5 4.5 7 0t7 0"></path>
				</svg>
				<span>Tone Split</span>
			</a>
			<a class="header-cta" href={appUrl}>Open app <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Left ear, right ear</p>
					<h1>Sound belongs in <em>your hands.</em></h1>
					<p class="lede">
						Tone Split is a small stereo synthesizer for hearing how pitch, timbre, level and space
						work on each other. Stack oscillators or load a chord, then move one voice and watch
						both channels answer.
					</p>
					<div class="hero-actions">
						<a class="primary-cta" href={appUrl}>Open Tone Split <span class="icon" set:html={icon('arrow-right', 16)} /></a>
						<p>Web, iOS and Android · best in headphones</p>
					</div>
				</div>

				<!-- Not a screenshot. The scope is the app's own oscillator maths run at
				     build time, and every dial is placed by the app's own angle formula,
				     so the picture stays sharp on any display and cannot quietly stop
				     being what the app does. -->
				<div class="device" aria-label="Tone Split with its four opening voices">
					<div class="frame-bar">
						<div class="frame-brand"><span class="menu-lines"></span> tonesplit / voice rack</div>
						<div class="frame-actions"><span class="icon" set:html={icon('unmute', 13)} /><span class="icon" set:html={icon('pulse', 13)} /></div>
					</div>

					<div class="screen">
						<div class="app-header">
							<span class="app-mark">TS</span>
							<span class="wordmark">TONE SPLIT</span>
							<span class="about">ABOUT <i>↗</i></span>
						</div>

						<p class="screen-heading">Oscillator</p>
						<div class="scope">
							<span class="channel-label">L</span>
							<span class="channel-label right">R</span>
							<svg viewBox="0 0 330 256" aria-hidden="true">
								{channelTones('left').map((tone) => <path d={wavePath(tone)} stroke={tone.colour} />)}
								<g transform="translate(0 128)">
									{channelTones('right').map((tone) => <path d={wavePath(tone)} stroke={tone.colour} />)}
								</g>
								<line class="divider" x1="0" y1="128" x2="330" y2="128"></line>
							</svg>
						</div>

						<p class="screen-heading">Voice rack</p>
						{
							voices.map((voice) => (
								<div class="voice" style={`border-top-color: ${voice.colour}`}>
									<div class="voice-head">
										<span class="voice-number">{voice.number}</span>
										<span class="wave-button"><i>∿</i>{voice.waveform.toUpperCase()}</span>
										<span class="status"><i />ON</span>
										<span class="remove">×</span>
									</div>
									<div class="dials">
										{voice.dials.map((dial) => (
											<div class="dial">
												<span class="dial-label">{dial.label}</span>
												<span class="knob"><i style={`transform: rotate(${dial.angle.toFixed(1)}deg)`} /></span>
												<span class="dial-value">{dial.display}</span>
											</div>
										))}
									</div>
								</div>
							))
						}
					</div>

					<div class="transport">
						<span class="pill"><i>＋</i> OSC</span>
						<span class="pill"><i>＋</i> CHORD</span>
						<span class="mode">VALUES</span>
						<span class="play" aria-hidden="true"></span>
					</div>
				</div>
			</section>

			<section class="principles" aria-label="How Tone Split works">
				<article>
					<span class="number">01</span>
					<div>
						<h2>Every voice is its own instrument</h2>
						<p>
							An oscillator carries a frequency from 20 Hz to 2 kHz, one of four waveforms, its own
							level, and its own place between hard left and hard right. Nothing is grouped and
							nothing is linked: mute one voice and it leaves the display while the rest carry on.
						</p>
					</div>
				</article>
				<article>
					<span class="number">02</span>
					<div>
						<h2>A chord is a starting point, not a preset</h2>
						<p>
							The library holds {chordNames.length} voicings, and picking one adds it as that many
							separate oscillators. The moment it lands there is nothing chord-shaped left about it —
							detune the third by two hertz, push the seventh hard right, mute the root and listen to
							what is underneath.
						</p>
					</div>
				</article>
				<article>
					<span class="number">03</span>
					<div>
						<h2>The display is the output, not decoration</h2>
						<p>
							Left channel above the line, right channel below. A voice panned left draws only in the
							top half, panned right only in the bottom, and a centred one draws in both — because
							that is where it is actually going. The height of each line is that voice's level.
						</p>
					</div>
				</article>
			</section>

			<section class="controls-section" aria-label="Chords and controls">
				<div class="section-head">
					<p class="eyebrow"><span></span> Turn it, or type it</p>
					<h2>Reach for a chord.<br />Then take it apart.</h2>
					<p>
						The dials are for the part of this that is listening — grab one, move it, hear the beat
						speed up or the field widen. When you want an exact figure instead, one tap swaps every
						dial for a number field with its range beside it, so 111 Hz is 111 Hz and not nearly.
					</p>
					<p class="aside">
						Frequency is bounded to 20—2000 Hz, level to 0—1, pan to hard left through hard right. The
						library is equal temperament off A440, so Amin7 arrives as four oscillators at {
							amin7.map((frequency) => `${frequency.toFixed(2)} Hz`).join(', ')
						} — and from there they are voices like any other.
					</p>
				</div>

				<div class="product-frame wide">
					<div class="frame-bar">
						<div class="frame-brand"><span class="menu-lines"></span> tonesplit / chord library</div>
						<div class="frame-actions"><span class="icon" set:html={icon('list-unordered', 13)} /><span class="icon" set:html={icon('pencil', 13)} /></div>
					</div>

					<div class="panes">
						<div class="pane library">
							<p class="pane-eyebrow">CHORD LIBRARY</p>
							<p class="pane-title">Load a voicing</p>
							<p class="pane-note">{chordNames.length} presets · tap to add</p>
							<div class="chords">{chordNames.slice(0, 24).map((chord) => <span>{chord}</span>)}</div>
						</div>

						<div class="pane values">
							<p class="pane-eyebrow">VALUES MODE</p>
							<p class="pane-title">Type the number</p>
							<p class="pane-note">Oscillator 01 · every field bounded</p>
							<div class="fields">
								<div class="field">
									<span class="field-label">FREQ<i>20—2000</i></span>
									<span class="field-input">108<b>Hz</b></span>
								</div>
								<div class="field">
									<span class="field-label">VOL<i>0—1</i></span>
									<span class="field-input">0.3</span>
								</div>
								<div class="field">
									<span class="field-label">PAN<i>L—R</i></span>
									<span class="field-input">-1</span>
								</div>
							</div>
							<p class="pane-foot">A figure outside the range is clamped to it, never rejected.</p>
						</div>
					</div>

					<div class="frame-keys">
						<span>∿</span> sine<i></i><span>⊓⊔</span> square<i></i><span>╱|╱</span> sawtooth<i></i><span>△</span> triangle
					</div>
				</div>
			</section>

			<section class="closing">
				<p>Two tones.<br />One beat.</p>
				<div class="chain">
					<span>OSCILLATOR</span><i></i><span>WAVEFORM</span><i></i><span>LEVEL</span><i></i><span>STEREO FIELD</span>
				</div>
				<div class="closing-actions">
					<a class="primary-cta light" href={appUrl}>Open Tone Split <span class="icon" set:html={icon('arrow-right', 16)} /></a>
					<p class="closing-note">108 and 111 Hz on the left. 114 and 117 on the right.</p>
				</div>
			</section>
		</main>

		<footer>
			<a class="brand footer-brand" href="/"><span>Tone Split</span></a>
			<p><a href={appUrl}>app</a> · pitch, timbre, level, space</p>
			<p>© {new Date().getFullYear()} Tone Split</p>
		</footer>
	</div>
</Full>

<style>
	.page-shell { min-height: 100svh; overflow-x: hidden; }
	.site-header { width: min(1180px, calc(100% - 40px)); height: 76px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 19px; font-weight: 760; letter-spacing: -.03em; text-decoration: none; }
	.brand-mark { width: 27px; height: 27px; }
	.brand-mark path:first-child { fill: var(--ink); stroke: none; }
	.brand-mark path:last-child { fill: none; stroke: var(--lime); stroke-width: 2; stroke-linecap: round; }
	.header-cta { display: inline-flex; align-items: center; color: var(--ink); border-bottom: 1px solid #c8cabf; padding: 6px 0; font-size: 13px; font-weight: 650; text-decoration: none; white-space: nowrap; }
	.header-cta span { margin-left: 5px; color: var(--lime-deep); }
	:global(.icon svg) { display: block; fill: currentColor; }

	.hero { width: min(1180px, calc(100% - 40px)); margin: 70px auto 110px; display: grid; grid-template-columns: 1fr 360px; align-items: center; gap: 80px; }
	.hero-copy { position: relative; z-index: 2; }
	.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: var(--quiet); font: 620 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
	.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--lime-deep); box-shadow: 0 0 0 4px rgba(85, 112, 28, .12); }
	h1 { max-width: 600px; margin: 0; color: var(--ink); font-size: clamp(46px, 6vw, 78px); font-weight: 590; line-height: .98; letter-spacing: -.062em; }
	h1 em { color: var(--lime-deep); font-family: Georgia, serif; font-weight: 400; }
	.lede { max-width: 520px; margin: 30px 0 32px; color: var(--quiet); font-size: 16px; line-height: 1.7; }
	.hero-actions { display: flex; align-items: center; gap: 20px; }
	.hero-actions p { margin: 0; color: #878c81; font: 500 10px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .05em; }
	.primary-cta { display: inline-flex; align-items: center; gap: 30px; border-radius: 4px; background: var(--ink); color: white; padding: 14px 18px; font-size: 13px; font-weight: 680; text-decoration: none; transition: transform .18s ease, background .18s ease; }
	.primary-cta:hover { transform: translateY(-2px); background: #292d22; }
	.primary-cta span { color: var(--lime); }

	/* The device and the wide frame share the house chrome: a light bar, then the
	   product. Everything below the bar is the app's own palette. */
	.device, .product-frame { position: relative; border: 1px solid #d5d8ce; border-radius: 9px; background: white; box-shadow: 0 35px 80px rgba(30, 40, 20, .15), 0 3px 10px rgba(30, 40, 20, .07); overflow: hidden; }
	.device { width: 360px; transform: perspective(1400px) rotateY(-4deg) rotateX(1deg); }
	.device::before, .product-frame::before { content: ''; position: absolute; z-index: -1; width: 340px; height: 340px; right: -70px; top: -90px; border-radius: 50%; background: var(--lime); filter: blur(80px); opacity: .45; }
	.frame-bar { height: 42px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e7e9e3; padding: 0 13px; color: #545a4d; font: 600 10px var(--mono); }
	.frame-brand, .frame-actions { display: flex; align-items: center; gap: 11px; }
	.menu-lines { width: 13px; height: 8px; border-block: 1px solid #777d70; position: relative; }
	.menu-lines::after { content: ''; position: absolute; left: 0; right: 0; top: 3px; border-top: 1px solid #777d70; }
	.frame-actions span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 4px; background: #f1f2ed; color: #444a3d; }

	/* The screen is cut off the way a phone cuts one off, with the third voice
	   half out of view -- a rack that ended neatly at the fold would be a rack
	   nobody scrolls. */
	.screen { position: relative; height: 700px; overflow: hidden; background: #0d0f0d; padding: 0 14px; }
	.screen::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 80px; background: linear-gradient(rgba(13, 15, 13, 0), #0d0f0d); }
	.app-header { height: 56px; display: flex; align-items: center; gap: 10px; }
	.app-mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: var(--lime); color: #11140d; font: 900 11px var(--sans); letter-spacing: -.05em; }
	.wordmark { color: #f1f2e9; font: 900 12px var(--sans); letter-spacing: .15em; }
	.about { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; color: #a9ada1; font: 800 10px var(--sans); letter-spacing: .13em; }
	.about i { color: var(--lime); font-style: normal; font-size: 13px; }
	.screen-heading { margin: 20px 0 12px; color: #e2e4da; font-size: 17px; font-weight: 700; }

	.scope { position: relative; border: 1px solid #363b32; border-radius: 18px; overflow: hidden; background: #0b0e0a; }
	.scope svg { display: block; width: 100%; height: auto; }
	.scope path { fill: none; stroke-width: 1.6; opacity: .88; vector-effect: non-scaling-stroke; }
	.scope .divider { stroke: #2d322a; stroke-width: 1; vector-effect: non-scaling-stroke; }
	.channel-label { position: absolute; left: 10px; top: 8px; z-index: 2; color: #949a8e; font: 900 10px var(--sans); }
	.channel-label.right { top: calc(50% + 8px); }

	.voice { border: 1px solid #343930; border-top-width: 2px; border-radius: 20px; background: #171a16; padding: 12px 14px; margin-bottom: 10px; }
	.voice-head { display: flex; align-items: center; gap: 8px; }
	.voice-number { color: #73796e; font: 300 20px var(--sans); font-variant-numeric: tabular-nums; }
	.wave-button { display: inline-flex; align-items: center; gap: 8px; height: 36px; border-radius: 12px; background: #242820; padding: 0 10px; color: #c5c8bd; font: 800 10px var(--sans); letter-spacing: .1em; }
	.wave-button i { color: var(--lime); font-style: normal; font-size: 17px; }
	.status { margin-left: auto; display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-width: 56px; height: 34px; border-radius: 17px; background: var(--lime); color: #18200e; font: 900 10px var(--sans); letter-spacing: .1em; }
	.status i { width: 7px; height: 7px; border-radius: 50%; background: #18200e; }
	.remove { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #242820; color: #d58b80; font: 300 21px/1 var(--sans); }
	.dials { display: flex; justify-content: space-between; border-top: 1px solid #30342d; margin-top: 12px; padding-top: 12px; }
	.dial { display: grid; justify-items: center; gap: 7px; min-width: 68px; }
	.dial-label { color: #a7ac9f; font: 800 10px var(--sans); letter-spacing: .12em; }
	/* The pointer is a bar at twelve o'clock rotated about the middle of the
	   knob, which is how the app positions it. */
	.knob { position: relative; width: 54px; height: 54px; border: 1px solid #555b4f; border-radius: 50%; background: #22271f; }
	.knob i { position: absolute; left: 50%; top: 0; width: 3px; height: 100%; margin-left: -1.5px; }
	.knob i::before { content: ''; position: absolute; left: 0; top: 4px; width: 3px; height: 17px; border-radius: 2px; background: var(--lime); }
	.dial-value { color: #d8dbd1; font: 600 12px var(--sans); font-variant-numeric: tabular-nums; }

	.transport { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; border-top: 1px solid #30342d; background: #11140f; padding: 11px 14px; }
	.pill { display: inline-flex; align-items: center; gap: 7px; height: 46px; border: 1px solid #343930; border-radius: 16px; background: #171a16; padding: 0 12px; color: #d5d8cc; font: 800 10px var(--sans); letter-spacing: .1em; }
	.pill i { color: var(--lime); font-style: normal; font-size: 15px; }
	.mode { margin-left: auto; display: grid; place-items: center; height: 46px; border: 1px solid #41453d; border-radius: 16px; padding: 0 13px; color: #c3c6bb; font: 900 10px var(--sans); letter-spacing: .1em; }
	.play { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 16px; background: var(--lime); }
	.play::before { content: ''; border: 7px solid transparent; border-left: 12px solid #171a10; margin-left: 5px; }

	.principles { width: min(1180px, calc(100% - 40px)); margin: 0 auto 120px; border-top: 1px solid #d7dacf; }
	.principles article { display: grid; grid-template-columns: 90px 1fr; border-bottom: 1px solid #d7dacf; padding: 32px 0; }
	.principles article div { display: grid; grid-template-columns: .75fr 1fr; align-items: baseline; gap: 40px; }
	.number { color: var(--lime-deep); font: 650 10px var(--mono); }
	.principles h2 { margin: 0; color: var(--ink); font-size: 22px; font-weight: 580; letter-spacing: -.035em; }
	.principles p { max-width: 560px; margin: 0; color: var(--quiet); font-size: 14px; line-height: 1.65; }

	.controls-section { width: min(1180px, calc(100% - 40px)); margin: 0 auto 110px; }
	.section-head { max-width: 620px; margin-bottom: 40px; }
	.section-head h2 { margin: 0 0 22px; color: var(--ink); font-size: clamp(32px, 4vw, 46px); font-weight: 560; line-height: 1.02; letter-spacing: -.05em; }
	.section-head p { margin: 0 0 14px; color: var(--quiet); font-size: 15px; line-height: 1.7; }
	.section-head .aside { max-width: 580px; color: #7b8177; font-size: 13.5px; }
